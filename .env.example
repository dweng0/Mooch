# .env.example — copy to .env and fill in values
# This file is safe to commit. The real .env is gitignored.

# URL of the Wasp backend (Node.js server).
# Default is localhost for devenv development.
# Change to your deployed URL for production builds.
WASP_API_URL=http://localhost:3001

# ── Claude Code CLI (long-lived token from `claude setup-token`) ───────────
# Provider "claude-code-cli". Used if ANTHROPIC_API_KEY is unset.
CLAUDE_CODE_OAUTH_TOKEN=
